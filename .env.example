# ===== 生产环境变量（阿里云 ECS · 全栈单机版） =====
# 复制为 .env:  cp .env.example .env   —— .env 永远不要提交进 Git
# compose 会自动读取本文件：POSTGRES_PASSWORD 同时用于初始化数据库和 web 的 DATABASE_URL

# PostgreSQL 密码（用户 obs / 库 observations），务必强随机
POSTGRES_PASSWORD=replace-with-strong-random-password

# 插件上报密钥（浏览器插件 X-API-Key）
# ⚠️ 必须与插件内置的 DEFAULT_API_KEY 完全一致，否则全部上报 403。
# 该密钥随插件 zip 分发、天然公开（见 auth.py 注释），"强随机"无意义；
# 当前生产值 = 公开内置值 ing_76b1aafdb8aa410c73c28139，只有重建插件时才可改。
INGEST_API_KEY=ing_76b1aafdb8aa410c73c28139

# 管理端密钥（明文只用于首次写入，服务端只存 SHA-256）；也可改用 ADMIN_KEY_HASH=sha256:<hex>
ADMIN_KEY=replace-with-long-random-string

# 商品分类：CLASSIFICATION_PROVIDER 可选 deepseek 或 qwen，只配置所选服务的真实密钥
CLASSIFICATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# 使用 Qwen 时改为 CLASSIFICATION_PROVIDER=qwen；QWEN_API_KEY 也可用 DASHSCOPE_API_KEY 代替
QWEN_API_KEY=replace-with-qwen-secret
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash

# ===== 注意 =====
# 1. 不要设置 VERCEL、DOCKER_COMPOSE 环境变量（会触发代码里的 SQLite 兜底逻辑）
# 2. 不要设置 SYNC_SERVER_URL / SYNC_USER_ID / SYNC_INTERVAL_SEC —— 那是本地采集端的配置
# 3. DATABASE_URL 不需要写在这里，docker-compose.yml 已用内网地址自动生成
# 4. 每周同步 Supabase 需要（本机 IPv4-only，必须走 pooler；# 等特殊字符须 URL 转义如 %23）：
# SUPABASE_DB_URL=postgresql://postgres.<project_ref>:<urlencoded密码>@aws-0-<region>.pooler.supabase.com:6543/postgres
